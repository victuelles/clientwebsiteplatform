-- Shared pgTAP helpers. Included by each test file with: \ir ../helpers.psql

set client_min_messages = warning;
-- Everything runs inside the test's transaction and is rolled back.

create extension if not exists pgtap with schema extensions;

create schema if not exists tests;

-- Creates an auth user (the auth trigger creates the profile) and sets the profile role.
create or replace function tests.create_user(user_id uuid, email text, role public.app_role default 'user')
returns uuid
language plpgsql
as $$
begin
  insert into auth.users (id, email, email_confirmed_at, aud, role)
  values (user_id, email, now(), 'authenticated', 'authenticated');
  update public.profiles p set role = create_user.role where p.id = user_id;
  return user_id;
end;
$$;

-- Sets the JWT claims PostgREST would set for this user. Follow with: set local role authenticated;
create or replace function tests.claims_for(user_id uuid)
returns void
language sql
as $$
  select set_config(
    'request.jwt.claims',
    json_build_object('sub', user_id, 'role', 'authenticated')::text,
    true
  );
$$;

-- Clears JWT claims (anon). Follow with: set local role anon;
create or replace function tests.clear_claims()
returns void
language sql
as $$
  select set_config('request.jwt.claims', '{"role": "anon"}', true);
$$;

grant usage on schema tests to anon, authenticated, service_role;
grant execute on all functions in schema tests to anon, authenticated, service_role;

-- Tests create their own super admin, so demote any seeded one for the duration of the test.
update public.profiles set role = 'user' where role = 'super_admin';
