# Copy to .env.local for local development. In Vercel, set these per client project.
# Blank optional values are treated as "not set".

# --- Required ---------------------------------------------------------------

# Public URL of this client's site, no trailing slash (e.g. https://www.clientsite.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase project URL (Project Settings > API, or `pnpm db:status` locally).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Supabase publishable key (sb_publishable_...). Safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key (sb_secret_...). SERVER ONLY. Bypasses RLS; never expose to the browser.
SUPABASE_SECRET_KEY=
# Email of the client's owner. The first confirmed sign-in with this email becomes the one super admin.
SUPER_ADMIN_EMAIL=

# --- Optional now, required in later phases ---------------------------------

# Stripe (Shop, Phase 11). All three are needed for Stripe to count as configured.
# Stripe secret key (sk_... or restricted rk_...). SERVER ONLY.
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (whsec_...). SERVER ONLY.
STRIPE_WEBHOOK_SECRET=
# Stripe publishable key (pk_...). Safe for the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend (Email marketing, Phase 10). Both are needed for Resend to count as configured.
# Resend API key (re_...). SERVER ONLY.
RESEND_API_KEY=
# Sender address on a verified Resend domain, e.g. "Client Name <hello@clientsite.com>".
RESEND_FROM_EMAIL=

# Mux (Video gallery, Phase 8). All three are needed for Mux to count as configured.
# Mux access token ID. SERVER ONLY.
MUX_TOKEN_ID=
# Mux access token secret. SERVER ONLY.
MUX_TOKEN_SECRET=
# Mux webhook signing secret. SERVER ONLY.
MUX_WEBHOOK_SECRET=

# --- Tooling ----------------------------------------------------------------

# Set to 1 to skip env validation (CI lint/build without real secrets). Never set in production.
# SKIP_ENV_VALIDATION=1
